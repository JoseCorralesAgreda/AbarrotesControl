@host = https://localhost:7091
# Errores (400/404/409/500): { status, title, message, errors, traceId }.
# Validación: errors = [{ field, error }]. RN-08: errors = { proveedorIds, productoIds }.
# Las respuestas exitosas conservan { data: ... }.
# CU-03 guarda un movimiento ENTRADA por línea en la misma transacción.
# Ajusta los ids a registros existentes; UsuarioSemillaId debe existir en usuarios.
@categoriaId = 1
@proveedorId = 1
@productoId = 1
@entradaId = 1
@ventaId = 1
# Ajustar a productos activos existentes con las condiciones indicadas.
@productoVencidoId = 2
@productoInactivoId = 3
# Cambia el nombre antes de repetir el caso válido.
@nombreProducto = Producto prueba CU02
@idInexistente = 2147483647

### Productos por nombre, categoría y estado (200)
GET {{host}}/api/productos?nombre=Arroz&categoriaId={{categoriaId}}&activo=true

### Stock con alertas (200)
GET {{host}}/api/stock?soloAlertas=true

### Alertas de stock bajo (200)
GET {{host}}/api/alertas?tipo=STOCK_BAJO

### Ventas por fechas inclusivas, máximo 50 (200)
GET {{host}}/api/ventas?desde=2026-01-01&hasta=2026-12-31

### Id de producto cero (400)
GET {{host}}/api/productos/0

### Id de entrada cero (400)
GET {{host}}/api/entradas/0

### Id de venta cero (400)
GET {{host}}/api/ventas/0

### Id de producto en stock cero (400)
GET {{host}}/api/stock/0

### Tipo inválido (400)
GET {{host}}/api/alertas?tipo=XYZ

### Categoría inválida en productos (400)
GET {{host}}/api/productos?categoriaId=-1

### Categoría inválida en stock (400)
GET {{host}}/api/stock?categoriaId=-1

### Rango de ventas invertido (400)
GET {{host}}/api/ventas?desde=2026-12-31&hasta=2026-01-01

### Fecha no convertible: mensaje de ModelState (400)
GET {{host}}/api/ventas?desde=fecha-invalida

### CU-04: venta válida; producto activo, no vencido y con stock >= 1 (201)
POST {{host}}/api/ventas
Content-Type: application/json

{ "detalles": [{ "productoId": {{productoId}}, "cantidad": 1 }] }

### Consultar venta; usar id devuelto por POST (200)
GET {{host}}/api/ventas/{{ventaId}}

### Últimas 50 ventas, más recientes primero (200)
GET {{host}}/api/ventas

### CU-05: stock filtrado (200)
GET {{host}}/api/stock?categoriaId={{categoriaId}}&buscar=&soloAlertas=false

### Stock de producto activo (200)
GET {{host}}/api/stock/{{productoId}}

### Alertas (200); admite también STOCK_BAJO, POR_VENCER y VENCIDO
GET {{host}}/api/alertas?tipo=SIN_STOCK

### Todas las alertas (200)
GET {{host}}/api/alertas

### RN-12: sin productos (400)
POST {{host}}/api/ventas
Content-Type: application/json

{ "detalles": [] }

### RN-12: cantidad cero (400)
POST {{host}}/api/ventas
Content-Type: application/json

{ "detalles": [{ "productoId": {{productoId}}, "cantidad": 0 }] }

### RN-12: cantidad fraccionaria (400)
POST {{host}}/api/ventas
Content-Type: application/json

{ "detalles": [{ "productoId": {{productoId}}, "cantidad": 1.5 }] }

### RN-12: producto repetido (400)
POST {{host}}/api/ventas
Content-Type: application/json

{ "detalles": [{ "productoId": {{productoId}}, "cantidad": 1 }, { "productoId": {{productoId}}, "cantidad": 2 }] }

### RN-13: stock insuficiente; elegir producto con stock menor a 2147483647 (409)
POST {{host}}/api/ventas
Content-Type: application/json

{ "detalles": [{ "productoId": {{productoId}}, "cantidad": 2147483647 }] }

### RN-14: producto vencido, fecha anterior a hoy (409)
POST {{host}}/api/ventas
Content-Type: application/json

{ "detalles": [{ "productoId": {{productoVencidoId}}, "cantidad": 1 }] }

### RN-14: producto inexistente (404)
POST {{host}}/api/ventas
Content-Type: application/json

{ "detalles": [{ "productoId": {{idInexistente}}, "cantidad": 1 }] }

### RN-14: producto inactivo (404)
POST {{host}}/api/ventas
Content-Type: application/json

{ "detalles": [{ "productoId": {{productoInactivoId}}, "cantidad": 1 }] }

### Stock: categoría inexistente (404)
GET {{host}}/api/stock?categoriaId={{idInexistente}}

### Stock: producto inexistente (404)
GET {{host}}/api/stock/{{idInexistente}}

### Stock: filtro booleano inválido (400)
GET {{host}}/api/stock?soloAlertas=incorrecto

### Alertas: tipo inválido (400)
GET {{host}}/api/alertas?tipo=OTRO

### Venta inexistente (404)
GET {{host}}/api/ventas/{{idInexistente}}

### CU-02: crear producto válido (201)
POST {{host}}/api/productos
Accept: application/json
Content-Type: application/json

{
  "nombre": "{{nombreProducto}}",
  "categoriaId": {{categoriaId}},
  "precioVenta": 12.5,
  "stockMinimo": 5,
  "fechaVencimiento": null
}

### Listar productos (200)
GET {{host}}/api/productos
Accept: application/json

### Consultar producto existente (200)
GET {{host}}/api/productos/{{productoId}}
Accept: application/json

### Listar categorías (200)
GET {{host}}/api/categorias
Accept: application/json

### CU-03: registrar entrada válida (201)
POST {{host}}/api/entradas
Accept: application/json
Content-Type: application/json

{
  "proveedorId": {{proveedorId}},
  "fechaEntrada": "2026-01-01",
  "nroDocumento": "ENT-001",
  "detalles": [
    {
      "productoId": {{productoId}},
      "cantidad": 10,
      "costoUnitario": 8
    }
  ]
}

### Consultar entrada existente (200); usa el id devuelto por el POST
GET {{host}}/api/entradas/{{entradaId}}
Accept: application/json

### Listar proveedores activos (200)
GET {{host}}/api/proveedores
Accept: application/json

### RN-01: ejecutar después del POST válido, mismo nombre (409)
POST {{host}}/api/productos
Accept: application/json
Content-Type: application/json

{
  "nombre": "{{nombreProducto}}",
  "categoriaId": {{categoriaId}},
  "precioVenta": 12.5,
  "stockMinimo": 5,
  "fechaVencimiento": null
}

